{
  "name": "notes-app",
  "version": "1.0.0",
  "description": "Приложение для заметок с паролями",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/notes-app.git"
  },
  "keywords": [
    "Electron",
    "notes",
    "passwords",
    "desktop"
  ],
  "author": {
    "name": "Oleksandr Maliuk",
    "email": "xvergox@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.notes.app",
    "productName": "Notes App",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*",
      "!*.md",
      "!data.json"
    ],
    "extraResources": [
      {
        "from": "data.json",
        "to": "data.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "deb",
      "icon": "icon.png",
      "category": "Utility",
      "maintainer": "Oleksandr Maliuk <xvergox@gmail.com>"
    }
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "homepage": "https://github.com/your-username/notes-app"
}